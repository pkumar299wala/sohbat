# GEMINI_API_KEY: Required for Gemini AI API calls if used.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Video Engine Selection: "cloudflare-webrtc" (default) | "livekit"
VITE_VIDEO_PROVIDER="cloudflare-webrtc"

# Cloudflare Realtime TURN / Calls Free Tier (server-side only)
CLOUDFLARE_TURN_TOKEN_ID=""
CLOUDFLARE_API_TOKEN=""

# Optional LiveKit VPS Switch (when migrating off Cloudflare later)
LIVEKIT_URL=""
LIVEKIT_API_KEY=""
LIVEKIT_API_SECRET=""

# Optional Firebase App Check reCAPTCHA v3 Site Key
VITE_FIREBASE_APPCHECK_SITE_KEY=""
